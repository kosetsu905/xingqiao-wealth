<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xingqiao.system.mapper.SalesOpportunityMapper">

    <resultMap type="com.xingqiao.system.domain.SalesOpportunity" id="SalesOpportunityResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="userTempId"    column="user_temp_id"    />
        <result property="employeeId"    column="employee_id"    />
        <result property="fullName"    column="full_name"    />
        <result property="phoneNumber"    column="phoneNumber"    />
        <result property="email"    column="email"    />
        <result property="investmentAmount"    column="investment_amount"    />
        <result property="investmentTimeIntent"    column="investment_time_intent"    />
        <result property="interestedProducts"    column="interested_products"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSalesOpportunityVo">
        select id, user_id, user_temp_id, employee_id, full_name, phoneNumber, email, investment_amount, investment_time_intent, interested_products, remark, status, create_by, create_time, update_by, update_time from sales_opportunity
    </sql>

    <select id="selectSalesOpportunityList" parameterType="com.xingqiao.system.domain.SalesOpportunity" resultMap="SalesOpportunityResult">
        <include refid="selectSalesOpportunityVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userTempId != null "> and user_temp_id = #{userTempId}</if>
            <if test="employeeId != null "> and employee_id = #{employeeId}</if>
            <if test="fullName != null  and fullName != ''"> and full_name like concat('%', #{fullName}, '%')</if>
            <if test="phoneNumber != null  and phoneNumber != ''"> and phoneNumber like concat('%', #{phoneNumber}, '%')</if>
            <if test="email != null  and email != ''"> and email = like concat('%', #{email}, '%')</if>
            <if test="investmentAmount != null "> and investment_amount = #{investmentAmount}</if>
            <if test="investmentTimeIntent != null  and investmentTimeIntent != ''"> and investment_time_intent = #{investmentTimeIntent}</if>
            <if test="interestedProducts != null  and interestedProducts != ''"> and interested_products = #{interestedProducts}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectSalesOpportunityById" parameterType="Long" resultMap="SalesOpportunityResult">
        <include refid="selectSalesOpportunityVo"/>
        where id = #{id}
    </select>

    <insert id="insertSalesOpportunity" parameterType="com.xingqiao.system.domain.SalesOpportunity" useGeneratedKeys="true" keyProperty="id">
        insert into sales_opportunity
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userTempId != null">user_temp_id,</if>
            <if test="employeeId != null">employee_id,</if>
            <if test="fullName != null">full_name,</if>
            <if test="phoneNumber != null and phoneNumber != ''">phoneNumber,</if>
            <if test="email != null and email != ''">email,</if>
            <if test="investmentAmount != null">investment_amount,</if>
            <if test="investmentTimeIntent != null and investmentTimeIntent != ''">investment_time_intent,</if>
            <if test="interestedProducts != null">interested_products,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userTempId != null">#{userTempId},</if>
            <if test="employeeId != null">#{employeeId},</if>
            <if test="fullName != null">#{fullName},</if>
            <if test="phoneNumber != null and phoneNumber != ''">#{phoneNumber},</if>
            <if test="email != null and email != ''">#{email},</if>
            <if test="investmentAmount != null">#{investmentAmount},</if>
            <if test="investmentTimeIntent != null and investmentTimeIntent != ''">#{investmentTimeIntent},</if>
            <if test="interestedProducts != null">#{interestedProducts},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateSalesOpportunity" parameterType="com.xingqiao.system.domain.SalesOpportunity">
        update sales_opportunity
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userTempId != null">user_temp_id = #{userTempId},</if>
            <if test="employeeId != null">employee_id = #{employeeId},</if>
            <if test="fullName != null">full_name = #{fullName},</if>
            <if test="phoneNumber != null and phoneNumber != ''">phoneNumber = #{phoneNumber},</if>
            <if test="email != null and email != ''">email = #{email},</if>
            <if test="investmentAmount != null">investment_amount = #{investmentAmount},</if>
            <if test="investmentTimeIntent != null and investmentTimeIntent != ''">investment_time_intent = #{investmentTimeIntent},</if>
            <if test="interestedProducts != null">interested_products = #{interestedProducts},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSalesOpportunityById" parameterType="Long">
        delete from sales_opportunity where id = #{id}
    </delete>

    <delete id="deleteSalesOpportunityByIds" parameterType="String">
        delete from sales_opportunity where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
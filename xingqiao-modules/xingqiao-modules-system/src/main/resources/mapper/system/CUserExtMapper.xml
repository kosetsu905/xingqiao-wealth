<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xingqiao.system.mapper.CUserExtMapper">

    <resultMap type="com.xingqiao.system.api.domain.CUser" id="CUserResult">
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="nickName"    column="nick_name"    />
        <result property="userType"    column="user_type"    />
        <result property="email"    column="email"    />
        <result property="phoneNumber"    column="phone_number"    />
        <result property="sex"    column="sex"    />
        <result property="avatar"    column="avatar"    />
        <result property="password"    column="password"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="loginIp"    column="login_ip"    />
        <result property="loginDate"    column="login_date"    />
        <result property="pwdUpdateDate"    column="pwd_update_date"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="countryCode"    column="country_code"    />
        <result property="account"    column="account"    />
    </resultMap>

    <sql id="selectCUserVo">
        select user_id, user_name, nick_name, user_type,
               email, phone_number, sex, avatar, password, status,
               del_flag, login_ip, login_date, pwd_update_date, create_by,
               create_time, update_by, update_time, remark ,account from c_user
    </sql>

    <select id="checkPhoneUnique"  resultType="com.xingqiao.system.api.domain.CommonUser">
        select user_id as userId, phone_number as phoneNumber from c_user
        where phone_number = #{phoneNmber} and user_type = #{userType} and del_flag = '0' limit 1
    </select>

    <select id="checkEmailUnique" resultType="com.xingqiao.system.api.domain.CommonUser">
        select user_id as userId, email from c_user
        where email = #{email} and user_type = #{userType} and del_flag = '0' limit 1
    </select>
    <select id="checkAccountUnique" resultType="com.xingqiao.system.api.domain.CommonUser">
        select user_id as userId, user_name as userName, account,account
        from c_user where account = #{account} and user_type = #{userType} and del_flag = '0' limit 1
    </select>
    <select id="selectCUserByAccount" resultType="com.xingqiao.system.api.domain.CommonUser">
        <include refid="selectCUserVo"/>
        where account = #{account} and user_type = #{userType} and del_flag = '0'
    </select>

</mapper>
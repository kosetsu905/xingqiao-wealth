<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xingqiao.system.mapper.SysShortLinkMapper">

    <resultMap type="SysShortLink" id="SysShortLinkResult">
        <result property="shortLinkId" column="short_link_id"/>
        <result property="shortCode" column="short_code"/>
        <result property="originalUrl" column="original_url"/>
        <result property="clickCount" column="click_count"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectSysShortLinkVo">
        select short_link_id, short_code, original_url, click_count, status, create_by, create_time, update_by, update_time, remark from sys_short_link
    </sql>

    <select id="selectSysShortLinkByShortLinkId" parameterType="Long" resultMap="SysShortLinkResult">
        <include refid="selectSysShortLinkVo"/>
        where short_link_id = #{shortLinkId}
    </select>

    <select id="selectSysShortLinkByShortCode" parameterType="String" resultMap="SysShortLinkResult">
        <include refid="selectSysShortLinkVo"/>
        where short_code = #{shortCode}
    </select>

    <select id="selectSysShortLinkList" parameterType="SysShortLink" resultMap="SysShortLinkResult">
        <include refid="selectSysShortLinkVo"/>
        <where>
            <if test="shortCode != null  and shortCode != ''"> and short_code = #{shortCode}</if>
            <if test="originalUrl != null  and originalUrl != ''"> and original_url = #{originalUrl}</if>
            <if test="clickCount != null "> and click_count = #{clickCount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <insert id="insertSysShortLink" parameterType="SysShortLink" useGeneratedKeys="true" keyProperty="shortLinkId">
        insert into sys_short_link
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="shortCode != null and shortCode != ''">short_code,</if>
            <if test="originalUrl != null and originalUrl != ''">original_url,</if>
            <if test="clickCount != null">click_count,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="shortCode != null and shortCode != ''">#{shortCode},</if>
            <if test="originalUrl != null and originalUrl != ''">#{originalUrl},</if>
            <if test="clickCount != null">#{clickCount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSysShortLink" parameterType="SysShortLink">
        update sys_short_link
        <trim prefix="SET" suffixOverrides=",">
            <if test="shortCode != null and shortCode != ''">short_code = #{shortCode},</if>
            <if test="originalUrl != null and originalUrl != ''">original_url = #{originalUrl},</if>
            <if test="clickCount != null">click_count = #{clickCount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null and createBy != ''">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where short_link_id = #{shortLinkId}
    </update>

    <delete id="deleteSysShortLinkByShortLinkId" parameterType="Long">
        delete from sys_short_link where short_link_id = #{shortLinkId}
    </delete>

    <delete id="deleteSysShortLinkByShortLinkIds" parameterType="Long">
        delete from sys_short_link where short_link_id in
        <foreach item="shortLinkId" collection="array" open="(" separator="," close=")">
            #{shortLinkId}
        </foreach>
    </delete>

</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xingqiao.system.mapper.employee.SysCustomerFinancialMapper">

    <resultMap type="com.xingqiao.system.domain.employee.SysCustomerFinancial" id="SysCustomerFinancialResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="userTempId"    column="user_temp_id"    />
        <result property="familyTotalAsset"    column="family_total_asset"    />
        <result property="familyDebt"    column="family_debt"    />
        <result property="familyAnnualIncome"    column="family_annual_income"    />
        <result property="newInvestmentAmount"    column="new_investment_amount"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSysCustomerFinancialVo">
        select id, user_id, user_temp_id, family_total_asset, family_debt, family_annual_income, new_investment_amount, status, remark, create_by, create_time, update_by, update_time from sys_customer_financial
    </sql>

    <select id="selectSysCustomerFinancialList" parameterType="com.xingqiao.system.domain.employee.SysCustomerFinancial" resultMap="SysCustomerFinancialResult">
        <include refid="selectSysCustomerFinancialVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userTempId != null "> and user_temp_id = #{userTempId}</if>
            <if test="familyTotalAsset != null "> and family_total_asset = #{familyTotalAsset}</if>
            <if test="familyDebt != null "> and family_debt = #{familyDebt}</if>
            <if test="familyAnnualIncome != null "> and family_annual_income = #{familyAnnualIncome}</if>
            <if test="newInvestmentAmount != null "> and new_investment_amount = #{newInvestmentAmount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectSysCustomerFinancialById" parameterType="Long" resultMap="SysCustomerFinancialResult">
        <include refid="selectSysCustomerFinancialVo"/>
        where id = #{id}
    </select>

    <insert id="insertSysCustomerFinancial" parameterType="com.xingqiao.system.domain.employee.SysCustomerFinancial" useGeneratedKeys="true" keyProperty="id">
        insert into sys_customer_financial
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userTempId != null">user_temp_id,</if>
            <if test="familyTotalAsset != null">family_total_asset,</if>
            <if test="familyDebt != null">family_debt,</if>
            <if test="familyAnnualIncome != null">family_annual_income,</if>
            <if test="newInvestmentAmount != null">new_investment_amount,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userTempId != null">#{userTempId},</if>
            <if test="familyTotalAsset != null">#{familyTotalAsset},</if>
            <if test="familyDebt != null">#{familyDebt},</if>
            <if test="familyAnnualIncome != null">#{familyAnnualIncome},</if>
            <if test="newInvestmentAmount != null">#{newInvestmentAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateSysCustomerFinancial" parameterType="com.xingqiao.system.domain.employee.SysCustomerFinancial">
        update sys_customer_financial
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userTempId != null">user_temp_id = #{userTempId},</if>
            <if test="familyTotalAsset != null">family_total_asset = #{familyTotalAsset},</if>
            <if test="familyDebt != null">family_debt = #{familyDebt},</if>
            <if test="familyAnnualIncome != null">family_annual_income = #{familyAnnualIncome},</if>
            <if test="newInvestmentAmount != null">new_investment_amount = #{newInvestmentAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysCustomerFinancialById" parameterType="Long">
        delete from sys_customer_financial where id = #{id}
    </delete>

    <delete id="deleteSysCustomerFinancialByIds" parameterType="String">
        delete from sys_customer_financial where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
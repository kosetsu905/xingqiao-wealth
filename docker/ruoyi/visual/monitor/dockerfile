# 基础镜像
FROM  openjdk:8-jre
# author
MAINTAINER xingqiao

# 挂载目录
VOLUME /home/xingqiao
# 创建目录
RUN mkdir -p /home/xingqiao
# 指定路径
WORKDIR /home/xingqiao
# 复制jar文件到路径
COPY ./jar/xingqiao-visual-monitor.jar /home/xingqiao/xingqiao-visual-monitor.jar
# 启动系统服务
ENTRYPOINT ["java","-jar","xingqiao-visual-monitor.jar"]